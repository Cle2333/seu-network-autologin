{
  // ==========================================================================
  //  东南大学校园网自动认证 —— 配置文件
  //
  //  * 支持 // 和 /* */ 注释：程序会先剥掉注释再解析
  //  * 改完立即生效，不用重启（每次运行都重新读）
  //  * 本文件含明文密码，已在 .gitignore 里，别提交
  //  * 通常不用手写：跑 `python3 seu_net.py init` 会自动生成
  // ==========================================================================

  // ---------- 账号密码（必填）----------
  "account": "一卡通号",          // 登录校园网时输入的那个号（一卡通号，不是学号）
  "password": "密码",             // 校园网和运营商宽带用的是同一个密码

  // ---------- 按网络环境排的账号写法 ----------
  // 实际提交的账号 = account_prefix + account + account_suffix。
  // 程序挑「这个环境能用」的那一条，写错的会被自动跳过，所以多写几条没关系。
  // 挑选顺序：
  //   1. 上次在这个网络里成功过的那条（记在 state.json）
  //   2. ssids 和当前 WiFi 名对得上的那条（macOS 没授权定位时读不到 WiFi 名，会跳过这步）
  //   3. 其余按 priority 从小到大依次试
  "profiles": [
    {
      "name": "运营商宽带（宿舍，优先）",
      "ssids": ["SEU-ISP"],
      "account_prefix": "",
      "account_suffix": "@cmcc",   // 移动 @cmcc / 电信 @dx / 联通 @lt
      "priority": 10,              // 数字小的先试
      "note": "宿舍里的 SEU-ISP，走运营商账号"
    },
    {
      "name": "校园网（教室）",
      "ssids": ["SEU-WLAN"],
      "account_prefix": ",0,",     // 校园网账号要带这个前缀
      "account_suffix": "",        // 且不带运营商后缀
      "priority": 20,
      "note": "教室里的 SEU-WLAN"
    }
  ],

  // ---------- 下面一般不用改 ----------

  // 校园门户是 Drcom。按顺序探测，谁回 Drcom 页面就用谁（换网段时可能要用不同的地址）
  "portal_urls": [
    "http://w.seu.edu.cn/",
    "http://10.80.128.2/",
    "http://10.9.10.100/"
  ],
  // 登录 / 注销走 801(http) 或 802(https)
  "portal_login_path": "/eportal/",
  "portal_logout_path": "/eportal/",
  // 在线状态查询走 80 端口的 drcom 内核接口（和上面不是同一个端口）
  "portal_status_path": "/drcom/chkstatus?callback=dr1002",

  // 外网校验：任何一条通就算通。门户说什么都不算数，真连出去才算认证成功
  "connectivity_checks": [
    {"url": "http://www.msftconnecttest.com/connecttest.txt", "expect": "Microsoft Connect Test"},
    {"url": "http://connect.rom.miui.com/generate_204", "expect": "", "status": 204}
  ],
  "connectivity_grace_seconds": 2,   // 两次校验之间等几秒
  "connectivity_attempts": 3,        // 提交认证后校验几次

  // 超时与重试节奏（秒）
  "request_timeout_seconds": 4,      // 探测门户 / 外网校验超时
  "login_timeout_seconds": 12,       // 提交认证超时（门户有时要几秒才回包）
  "fast_retry_seconds": 2,           // 刚启动那几分钟的重试间隔
  "fast_retry_window_seconds": 120,  // 「刚启动」持续多少秒
  "retry_interval_seconds": 10,      // 之后的重试间隔
  "max_wait_seconds": 300,           // 单次运行最多等多久（等 WiFi 起来）

  // 日志：超过 log_max_kb 就轮转成 login.log.1 / .2 / …，
  // 最多留 log_backup_count 份，多出来的删最旧的。总占用 = (份数+1) × 上限
  "log_file": "login.log",
  "log_max_kb": 512,
  "log_backup_count": 3,

  // 完全没网时，主动去连这些无线网络（只在「一个可用网络都没有」时动手）
  "wifi_auto_connect": true,
  "wifi_order": ["SEU-ISP", "SEU-WLAN"],
  "wifi_interface": "",              // 留空 = 自动检测（mac 一般 en0，Windows 是 WLAN）
  "wifi_connect_after_seconds": 8,
  "wifi_connect_interval_seconds": 30
}
